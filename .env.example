# Copy to .env and edit. scripts/build.sh creates it with the two UID lines.

# So files the containers write into the repo (plan.json, timings.json) are
# owned by you and not root. `id -u` / `id -g`.
#DOCKER_UID=1000
#DOCKER_GID=1000

# Choregraphe virtual robot running on the host (Option B in the README):
#   the port is the one Choregraphe prints in its title bar / connection dialog
#   (it is random-ish, e.g. 61476 - not 9559).
#NAO_IP=host.docker.internal
#NAO_PORT=61476

# A real NAO on the wifi:
#NAO_IP=192.168.1.11
#NAO_PORT=9559

# For scripts/start_robot.sh: the extracted Choregraphe directory (the one
# containing bin/ and lib/). Its bundled naoqi-bin is the virtual robot.
#CHOREGRAPHE_HOME=/home/you/Downloads/choregraphe-2.8.8-ubuntu2204-standalone/choregraphe-2.8.8-ubuntu2204
